APP_ENV=development
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://recalltrace:CHANGE_ME@127.0.0.1:5432/recalltrace
SESSION_REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# Optional local-only account mail, relative to the private Flask instance directory.
# Set to account-mail to enable development invitations/recovery/verification.
# Recovery/verification also require a running outbox worker with the same settings.
ACCOUNT_MAIL_DIR=

# Generate securely; encrypts MFA secrets and derives separate account-queue keys.
# Web and outbox worker must use the same key/version. Never commit a real key.
MFA_ENCRYPTION_KEY=
MFA_KEY_VERSION=v1

# Production-only settings: supply real values securely through the host, not Git.
# See documentation/DEPLOYMENT.md. Local defaults above are development-only.
# APP_ENV=production
# ALLOWED_HOSTS=
# TRUSTED_PROXY_HOPS=1
# Remote DATABASE_URL requires sslmode=verify-full and a trusted sslrootcert file.
# Both remote Redis URLs require rediss, authentication, ssl_cert_reqs=required,
# and ssl_check_hostname=true. Local Redis fallbacks are rejected in production.
# Upstash supports only database /0: use the same verified TLS URL for both remote
# settings; existing session/rate key prefixes separate them. Keep local URLs above.
# See documentation/UPSTASH.md. Use Connect > TCP, not the REST URL/token pair.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_STORAGE_BUCKET=recalltrace-private
# SUPABASE_SERVICE_KEY=
# SCANNER_ENDPOINT=
# Alternatively: CLAMAV_HOST and CLAMAV_PORT for an authorized private scanner.
# MAIL_MODE=resend
# MAIL_API_KEY=
# MAIL_FROM=
# ACCOUNT_MAIL_DIR must be unset in production.
# Development notice delivery: MAIL_MODE=local plus ACCOUNT_MAIL_DIR=account-mail.

# Optional operator-host backup tooling; not needed by the web/worker processes.
# Build: docker build --target database-tools -t recalltrace:database-tools .
# Without this setting, pg_dump/pg_restore must be installed on the operator host.
# RECALLTRACE_PG_TOOLS_IMAGE=recalltrace:database-tools
# For a local Compose database only, use its actual existing private bridge:
# RECALLTRACE_PG_TOOLS_NETWORK=your-existing-private-network
# RECALLTRACE_PG_TOOLS_HOST=postgres
